# Copy to .env and fill in. Never commit the real .env.
#   cp .env.example .env
# Every value below is read by the code — see module references for the source.

# ---------------------------------------------------------------------------
# Required — the app will not start or the feature will fail without these
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string. Read by src/db/connection.py (no default;
# raises if unset) and src/migrations/env.py for Alembic.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cache (Dragonfly / any Redis-compatible). Read by src/cache/dragonfly.py.
# If your instance needs auth, embed it HERE — there is no DRAGONFLY_PASSWORD
# variable; the password is part of the URL.
# Local default from docker-compose.yml:
DRAGONFLY_URL=redis://localhost:6379

# S3-compatible object storage for PDF uploads (Neon Object Storage).
# Read by src/services/object_storage.py. All four are required for
# POST /v1/materials/upload to work.
AWS_ENDPOINT_URL_S3=https://your-bucket.s3.us-east-2.amazonaws.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# Bucket that holds uploaded PDFs. Read by src/services/material_service.py.
NEON_STORAGE_BUCKET=materials

# LLM provider — required for question generation and answer scoring.
# Read by src/services/openrouter_service.py; raises RuntimeError if unset.
OPENROUTER_API_KEY=sk-or-...

# Speech-to-text — required for voice answers (GET /v1/stt/token).
# Read by src/services/stt_service.py. Without it, practice is text-only.
ELEVENLABS_API_KEY=sk_...

# ---------------------------------------------------------------------------
# Auth — own Google OAuth + session tokens (no third parties)
# ---------------------------------------------------------------------------
# Google OAuth client (Web type). Read by src/services/auth_service.py.
# Register this redirect URI in Google Cloud Console → Authorized redirect URIs:
#   {API_EXTERNAL_BASE_URL}/v1/auth/google/callback
GOOGLE_CLIENT_ID=1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Public base URL of this API (used to build the OAuth redirect_uri above).
API_EXTERNAL_BASE_URL=http://localhost:8000

# Where the SPA lives (OAuth callback redirects back here with a one-time code).
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# CORS — required for the web frontend to reach the API
# ---------------------------------------------------------------------------
# Comma-separated allowed origins, read by src/api/app.py.
#
# THIS IS EASY TO MISS AND BREAKS THE FRONTEND SILENTLY. If this is unset or
# empty, the CORS middleware is never registered, and every browser request
# from the React app is blocked — you get a CORS error in DevTools (not a
# network failure) and preflight OPTIONS calls return 405.
#
#   Web app on http://localhost:5173  ->  CORS_ORIGINS=http://localhost:5173
#   Production                        ->  CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Optional — defaults shown, override only if you need to
# ---------------------------------------------------------------------------

# Comma-separated Host allowlist. Read by src/api/app.py. Empty = allow all,
# which is fine locally but should be set in production.
TRUSTED_HOSTS=

# OpenRouter tuning. All read by src/services/openrouter_service.py.
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
# Tried in order when the primary model fails.
OPENROUTER_MODELS=poolside/laguna-s-2.1:free,qwen/qwen3.8-27b:free
# Optional attribution headers OpenRouter uses for dashboard ranking.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# Max PDF upload size in bytes (default 25 MB).
# Read by src/api/routes/materials.py.
MAX_PDF_UPLOAD_BYTES=26214400
